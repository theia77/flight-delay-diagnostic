    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How the cascade was measured",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2328",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Flights were ordered by aircraft (tail number) and departure time. A flight counts as a potential cascade when the same aircraft’s previous flight arrived 15+ minutes late, the gap between the two flights was 4 hours or less, and this flight was also delayed.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "What it does and does not show",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2328",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This is an association, not proof of cause: consecutive flights also share airports, weather and congestion. It still shows where operational focus pays off: protecting turnarounds after a late arrival.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Source: U.S. DOT on-time data (Kaggle), December 2015. Analysis in Python and SQL; see the project README.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514E"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
